Include ~/.ssh/config.local

Host c2
  User root

Host codeberg.org
  AddKeysToAgent 4h
  HostName codeberg.org
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  User git

Host github.com
  AddKeysToAgent 4h
  HostName github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  User git

Host *
  AddKeysToAgent no
  Compression no
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no
  ForwardAgent no
  HashKnownHosts no
  ServerAliveCountMax 3
  ServerAliveInterval 0
  SetEnv TERM="xterm-256color"
  UserKnownHostsFile ~/.ssh/known_hosts
