# Ghostty follows the desktop light/dark preference published by Noctalia.
theme = light:Atom One Light,dark:Ghostty Default Dark
window-theme = system

# Keep idle terminal windows from triggering Steam's shader compiler I/O throttle.
async-backend = epoll

# Alternatives:
# theme = light:Builtin Light,dark:Builtin Dark
# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
