#!/usr/bin/env -S uv run --python 3.13 --no-project python
"""Run T3's Codex commands with the existing CLIProxy profile and scoped OTel."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (str, int, float)):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(
            json.dumps(key) + " = " + toml_value(item)
            for key, item in value.items()
        ) + "}"
    raise ValueError("Unsupported value in CLIProxy profile")


def main():
    home = Path.home()
    codex_home = Path(os.environ.get("CODEX_HOME", home / ".codex"))
    profile = codex_home / "cliproxy.config.toml"
    config = tomllib.loads(profile.read_text())
    provider = config["model_provider"]
    key_name = config["model_providers"][provider]["env_key"]
    if key_name != "J2_CODEX_CPA_KEY":
        raise ValueError("CLIProxy credential source changed; update this launcher")

    # Service launches do not read .bashrc. Read the existing private loader in
    # a child shell, then retain only the Codex credential, never other exports.
    if not os.environ.get(key_name):
        result = subprocess.run(
            ["bash", "--noprofile", "--norc", "-c",
             'set -e; . "$HOME/.bash_secrets" >/dev/null; '
             'printf "%s" "${J2_CODEX_CPA_KEY:-}"'],
            capture_output=True, text=True, check=False,
        )
        if result.returncode or not result.stdout.strip():
            raise ValueError("CLIProxy credential unavailable in ~/.bash_secrets")
        os.environ[key_name] = result.stdout.strip()

    # app-server rejects --profile. Its equivalent -c overrides work for every
    # T3 invocation, including app-server, exec, mcp list and version checks.
    overrides = []
    for key, value in config.items():
        overrides.extend(["-c", key + "=" + toml_value(value)])
    # app-server disables the metrics pipeline unless analytics is opted in.
    overrides.extend(["-c", "analytics.enabled=true"])
    root = Path(__file__).resolve().parent
    command = [str(root / "agent-otel-run"),
               str(home / ".npm-global/bin/codex"), *overrides, *sys.argv[1:]]
    os.execv(command[0], command)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        print(f"t3-codex-proxy: {error}", file=sys.stderr)
        sys.exit(1)
